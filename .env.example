# ============================================================
# Shorty — Environment Configuration Template
# Copy this file to .env and adjust values for your environment
# ============================================================

PORT=8080
FRONTEND_DIR=../frontend
DATABASE_URL=postgres://shorty:shorty_secret@localhost:5432/shorty_db?sslmode=disable
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-this-to-a-secure-random-secret-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
EPHEMERAL_TTL=2h
CLICK_BATCH_SIZE=100
CLICK_FLUSH_INTERVAL=2s
